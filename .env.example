# Database — leave blank to use the default local SQLite store.
AGENT_DATABASE_URL=sqlite:///./data/agent.db

# LLM provider — auto-detected from whichever key is set below.
# This agent uses Google Gemini. Set AGENT_GEMINI_API_KEY and leave the
# Anthropic key blank, and the provider auto-selects "gemini".
# Override explicitly if needed: anthropic | gemini
# AGENT_LLM_PROVIDER=gemini

# Models (env-configurable; defaults shown):
#   AGENT_LLM_MODEL       — code/finalize model (default: gemini-3.1-pro)
#   AGENT_LLM_MODEL_FAST  — cheap plan/effort-classification model (default: gemini-2.5-flash)
# AGENT_LLM_MODEL=gemini-3.1-pro
# AGENT_LLM_MODEL_FAST=gemini-2.5-flash

# Provider keys — set the Gemini key for this agent; leave Anthropic blank.
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=

PORT=8001
